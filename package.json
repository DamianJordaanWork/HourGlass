{
  "name": "hourglass",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Hourglass — the ultimate time tracker. Quick-track Azure DevOps tickets and calendar meetings straight into Harvest.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
